# ==============================================================================
# WorkDesk AI - Environment Configuration Template
# Copy this file to .env and adjust variables for your local or cloud environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend REST endpoints
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_ENV="development"
VITE_APP_NAME="WorkDesk AI"

# ------------------------------------------------------------------------------
# BACKEND CORE CONFIGURATION (FastAPI)
# ------------------------------------------------------------------------------
PROJECT_NAME="WorkDesk AI Backend"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="INFO"

# Secret key for JWT session encryption (generate with `openssl rand -hex 32`)
SECRET_KEY="insecure-dev-secret-change-me-in-production-min-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated list for local frontend dev servers)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Standard connection string format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/workdesk_ai"
DATABASE_URL_SYNC="postgresql+psycopg2://postgres:postgres@localhost:5432/workdesk_ai"

# Individual credentials for Docker Compose container
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="workdesk_ai"
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# AI PROVIDERS (Configured for Phase 3 - keep empty during Phase 1)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
MISTRAL_API_KEY=""
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# BILLING & PAYMENTS (Configured for Phase 2 - keep empty during Phase 1)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
